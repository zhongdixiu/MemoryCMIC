MEMORY_POSTGRES_IMAGE=pgvector/pgvector:pg15
MEMORY_POSTGRES_PORT=5433
MEMORY_POSTGRES_DB=memory_cmic
MEMORY_POSTGRES_USER=memory_cmic
MEMORY_POSTGRES_PASSWORD=replace-with-a-local-development-password
MEMORY_DATABASE_URL=postgresql+psycopg://memory_cmic:replace-with-a-local-development-password@localhost:5433/memory_cmic

# Static service credentials for the first-stage API. Keep real tokens out of version control.
MEMORY_AUTH_CREDENTIALS_JSON='[{"token":"replace-with-a-long-random-token","tenant_id":"tenant_example","caller_agent_id":"email_agent","allowed_source_systems":["email_agent"]}]'

# Alibaba Cloud Model Studio, OpenAI-compatible API.
DASHSCOPE_API_KEY=replace-with-dashscope-api-key
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen3.8-max

# SiliconFlow, OpenAI-compatible embeddings API.
SILICONFLOW_API_KEY=replace-with-siliconflow-api-key
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_EMBEDDING_MODEL=BAAI/bge-m3

# Similarity only routes candidates to Qwen; it never hard-drops a fact.
MEMORY_DUPLICATE_CANDIDATE_THRESHOLD=0.85

# Optional: required only by Honcho migration commands and run_validation.sh --with-honcho.
# Use a dedicated read-only role; transaction_read_only is also enforced by the migration tools.
HONCHO_DATABASE_URL=postgresql+psycopg://honcho_readonly:replace-with-a-readonly-password@localhost:5432/honcho?options=-c%20default_transaction_read_only%3Don
